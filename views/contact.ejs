<%- include('partials/head') %>
  <script src="/js/contact-form.js" defer></script>
</head>
<body>
  <%- include('partials/header') %>
  <main class="contact-main">
    <!-- Samme oppsett som Om-siden: bildet i full bredde, teksten til venstre -->
    <div class="about-hero contact-hero">
      <img class="about-hero-img" src="<%= c.photo.src %>" srcset="<%= c.photo.srcset %>" sizes="100vw"
           width="<%= c.photo.width %>" height="<%= c.photo.height %>" alt="<%= c.photo.alt %>">
      <div class="about-hero-text">
        <h1><%= t.pages[page].label %></h1>
        <p class="contact-lead"><%= c.lead %></p>
      </div>
    </div>

    <div class="about-body">
      <section class="about-section" id="skjema">
        <h2><%= c.form.formHeading %></h2>
        <div>
<% if (query.sendt !== undefined) { %>
          <p class="form-status" role="status"><strong><%= c.form.thanksTitle %></strong> <%= c.form.thanks %></p>
<% } else if (query.feil !== undefined) { %>
          <p class="form-status form-status-error" role="alert"><%= c.form.error %> <a href="mailto:<%= c.email %>"><%= c.email %></a>.</p>
<% } %>
          <form class="contact-form" action="/api/contact" method="post">
            <input type="hidden" name="lang" value="<%= t.lang %>">

            <label for="cf-name"><%= c.form.name %></label>
            <input id="cf-name" name="name" type="text" required maxlength="100" autocomplete="name">

            <label for="cf-email"><%= c.form.emailLabel %></label>
            <input id="cf-email" name="email" type="email" required maxlength="200" autocomplete="email">

            <label for="cf-message"><%= c.form.message %></label>
            <textarea id="cf-message" name="message" rows="6" required maxlength="5000"></textarea>

            <!-- Felle for roboter: skjult for mennesker -->
            <div class="cf-trap" aria-hidden="true">
              <label for="cf-website">Website</label>
              <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off">
            </div>

            <button type="submit" data-label-sending="<%= c.form.sending %>"><%= c.form.send %></button>
            <p class="form-status form-status-error" role="alert" hidden><%= c.form.error %> <a href="mailto:<%= c.email %>"><%= c.email %></a>.</p>
          </form>

          <p class="contact-direct"><%= c.form.orEmail %> <a href="mailto:<%= c.email %>"><%= c.email %></a></p>
        </div>
      </section>

      <section class="about-section contact-classes">
        <h2><%= c.classesHeading %></h2>
        <div>
          <p><%- c.classes %></p>
        </div>
      </section>
    </div>

    <!-- Pop-up etter at meldingen er sendt -->
    <dialog class="thanks-dialog" aria-labelledby="thanks-title">
      <h2 id="thanks-title"><%= c.form.thanksTitle %></h2>
      <p><%= c.form.thanks %></p>
      <button type="button" class="thanks-close"><%= c.form.close %></button>
    </dialog>
  </main>
  <footer>© <%= year %> Anahí Sucarrat Johnsen · Oslo</footer>
</body>
</html>
