<%- include('partials/head') %>
  <script src="/js/hero-video.js" defer></script>
</head>
<body>
  <%- include('partials/header') %>
  <main class="hero">
    <video class="hero-video" autoplay muted loop playsinline webkit-playsinline preload="auto"
           poster="/video/solea1tere-poster.jpg" src="/video/solea1tere.mp4"
           aria-hidden="true" tabindex="-1"></video>
    <div class="hero-overlay" aria-hidden="true"></div>
    <button class="video-toggle" type="button" hidden
            data-label-pause="<%= t.videoPause %>"
            data-label-play="<%= t.videoPlay %>"><%= t.videoPause %></button>

    <div class="hero-text">
      <h1>Anahí <span>Sucarrat Johnsen</span></h1>
      <p class="pronounce">(<%= t.pronounce %> <em>anna-i <span aria-hidden="true">/</span> anaí</em>)</p>
      <p class="tagline"><%= t.tagline %></p>
      <ul class="roles">
<% t.roles.forEach(function (role) { %>
        <li><%= role %></li>
<% }) %>
      </ul>
    </div>
  </main>

  <section class="home-intro">
    <p class="intro-lead"><%= t.intro %></p>
    <div class="intro-body">
      <p><%= t.introBody[0] %></p>
    </div>
  </section>

  <!-- Legenden om Anahí og ceibo-blomsten, med blomsten som bakgrunn -->
  <section class="home-legend">
    <img class="legend-bg" src="/img/ceibo-2000.jpg" srcset="/img/ceibo-1000.jpg 1000w, /img/ceibo-2000.jpg 2000w"
         sizes="100vw" alt="" loading="lazy">
    <p><%= t.introBody[1] %></p>
    <div class="home-more">
      <a class="more-link" href="<%= url(t.lang, 'about') %>"><%= t.introMore %> <span aria-hidden="true">→</span></a>
    </div>
  </section>


  <section class="home-contact">
    <p class="soon"><%= t.soon %></p>
    <a class="contact" href="mailto:johnsenanahi@gmail.com">johnsenanahi@gmail.com</a>
  </section>

  <footer>© <%= year %> Anahí Sucarrat Johnsen · Oslo</footer>
</body>
</html>
