<!doctype html>
<html lang="<%= t.lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t.title %></title>
  <meta name="description" content="<%= t.description %>">
  <link rel="canonical" href="<%= siteUrl + t.path %>">
  <link rel="alternate" hreflang="no" href="<%= siteUrl + locales.no.path %>">
  <link rel="alternate" hreflang="en" href="<%= siteUrl + locales.en.path %>">
  <link rel="alternate" hreflang="x-default" href="<%= siteUrl + locales.no.path %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Inter:wght@300;400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <nav class="lang">
    <a href="<%= other.path %>" hreflang="<%= other.lang %>" lang="<%= other.lang %>"><%= t.switchLabel %></a>
  </nav>
  <main class="hero">
    <p class="eyebrow"><%= t.eyebrow %></p>
    <h1>Anahí <span>Sucarrat Johnsen</span></h1>
    <p class="pronounce"><%= t.pronounce %> <em>«Anai»</em></p>
    <p class="soon"><%= t.soon %></p>
    <a class="contact" href="mailto:post@anna-i.no">post@anna-i.no</a>
  </main>
  <footer>© <%= year %> Anahí Sucarrat Johnsen · Oslo</footer>
</body>
</html>
