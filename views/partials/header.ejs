<header class="site-header">
  <!-- Logoen til venstre: lenke til forsiden -->
  <a class="wordmark" href="<%= url(t.lang, 'home') %>">
    <img src="/img/logo.png" width="330" height="150" alt="Anahí Sucarrat Johnsen">
  </a>

  <div class="header-right">
    <button class="menu-toggle" type="button" hidden aria-expanded="false" aria-controls="main-nav"
            data-label-open="<%= t.menuOpen %>" data-label-close="<%= t.menuClose %>"><%= t.menuOpen %></button>

    <nav id="main-nav" class="main-nav" aria-label="<%= t.mainNavLabel %>">
      <ul>
<% Object.keys(t.pages).forEach(function (key) { %>
        <li><a href="<%= url(t.lang, key) %>" <%- key === page ? 'aria-current="page"' : '' %>><%= t.pages[key].label %></a></li>
<% }) %>
      </ul>
    </nav>

    <!-- Språkvalg som nedtrekksmeny (fungerer også uten JavaScript) -->
    <details class="lang">
      <summary aria-label="<%= t.langNavLabel %>: <%= t.langName %>"><%= t.lang.toUpperCase() %> <span aria-hidden="true">▾</span></summary>
      <ul>
<% Object.values(locales).forEach(function (l) { %>
        <li><a href="<%= url(l.lang, page) %>" hreflang="<%= l.lang %>" lang="<%= l.lang %>"
               <%- l.lang === t.lang ? 'aria-current="page"' : '' %>><%= l.langName %></a></li>
<% }) %>
      </ul>
    </details>
  </div>
</header>
